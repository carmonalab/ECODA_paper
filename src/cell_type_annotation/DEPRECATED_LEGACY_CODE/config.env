# config.env
PROJECT_ROOT=/home/users/h/halterc/analysis_Yan_2026_42129561
DS_NAME=Yan_2026_42129561
NAS_PREFIX=/srv/smednas515.unige.ch/carmona_smb
USER_EMAIL=christian.halter@unige.ch

# Pipeline Processing Options
SAMPLE_COLNAME=donor_id
TISSUE_TYPE=Tumor # Can be "Blood" or anything else falling back to tumor
GET_CELLTYPE_COMP=true
AUTHOR_ANNOT_COLNAMES=cell_type,cell_state # Leave empty if none, or comma-separated: e.g., cell_type_pred,author_cluster

# Maximum number of parallel workers to spawn
MAX_NUM_CHUNKS_PARALLEL=999

# Gene ref dir
GENE_REF_FILE="${PROJECT_ROOT}/EnsemblGenes105_Hsa_GRCh38.p13.txt.gz"
GENE_REF_URL="https://raw.githubusercontent.com/carmonalab/scRNAseq_data_processing/master/aux/EnsemblGenes105_Hsa_GRCh38.p13.txt.gz"

# Ref map dir
NAS_REF_DIR=${NAS_PREFIX}/DataCollections/reference_atlases/sketched_200ct/
HOME_REF_DIR=${HOME}/${DS_NAME}/reference_atlases/sketched_200ct/

# Input dir
NAS_DATA_DIR=${NAS_PREFIX}/DataCollections/Standardized_SingleCell_Datasets/${DS_NAME}/data/
HOME_DATA_DIR=${HOME}/${DS_NAME}/data/

# Output dir
NAS_TARGET_DIR="${NAS_PREFIX}/DataCollections/Standardized_SingleCell_Datasets/${DS_NAME}"
SCRATCH_OUTPUT_DIR="${HOME}/${DS_NAME}/output"

# Chunks dir
HOME_CHUNKS_DIR="${HOME}/${DS_NAME}/output/chunks"